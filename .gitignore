# =========================================================
# NeoCobbleverse - .gitignore
# packwiz versiona .pw.toml; los .jar y .zip se descargan
# =========================================================

# --- Binarios de mods (los descarga packwiz desde .pw.toml) ---
mods/**/*.jar
mods/**/*.disabled
mods/.connector/

# --- Resource packs descargados (versionados via .pw.toml) ---
resourcepacks/**/*.zip
resourcepacks/**/*.rpo

# --- Datapacks descargados (no van en packwiz, backup aparte) ---
datapacks/**/*.zip
datapacks/extra/

# --- Exports de CurseForge / server pack (van a GitHub Releases, no al repo) ---
NeoCobbleverse*.zip
*-export.zip
server-pack/

# --- Shaderpacks ---
shaderpacks/*.zip
shaderpacks/*.zip.txt

# --- Mundos y estado del jugador ---
saves/
backups/
screenshots/
replay_recordings/
schematics/

# --- Logs y crashes ---
logs/
crash-reports/
.cache/
hs_err_pid*.log
fabricloader.log

# --- Caches / datos generados por mods en runtime ---
.mixin.out/
.sable/
.fabric/
cobblemon-battle-logs/
cobblenav/
data/
moddata/
defaultconfigs/
downloads/
emi.json
ponders_watched.json
legendary-monuments-data/
XaeroWaypoints*/
xaero/
shaderpacks/
journeymap/
mods/cache/
config/cache/

# Pero NO ignorar los defaultconfigs propios si los hay (descomenta si quieres versionarlos)
# !defaultconfigs/.gitkeep

# --- Metadata del launcher de CurseForge (se regenera) ---
minecraftinstance.json
manifest.json
modlist.html
profile.json
.curseclient

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
